    <!-- Device Admin specific strings -->
    <string name="device_admin_activation_title">إذن مسؤول الجهاز</string>
    <string name="device_admin_activation_message">يسمح الوصول إلى مسؤول الجهاز بتعزيز حظر التطبيقات من خلال السماح للتطبيق بإغلاق التطبيقات المحظورة بالقوة. هذا الإذن اختياري ويحسن إمكانيات الحظر.</string>
    <string name="device_admin_explanation">يسمح الوصول إلى مسؤول الجهاز لحرم بلور بإغلاق التطبيقات المحظورة بالقوة لتعزيز أقوى. هذا اختياري تمامًا - يعمل التطبيق بدونها.</string>
    <string name="device_admin_disabled_message">تم تعطيل إذن مسؤول الجهاز. سيعود الحظر إلى خدمة إمكانية الوصول فقط.</string>

