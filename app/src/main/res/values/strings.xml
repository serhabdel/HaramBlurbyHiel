    <string name="why_usage_stats_title">Why Usage Stats Access?</string>
    <string name="why_usage_stats_explanation">Usage Stats permission allows HaramBlur to:\n\n• Detect when blocked apps are launched\n• Apply blocking immediately\n• Provide faster response times\n• Monitor app usage patterns\n\nThis permission is optional and only enhances blocking speed.</string>

    <string name="why_device_admin_title">Why Device Admin Access?</string>
    <string name="why_device_admin_explanation">Device Admin permission allows HaramBlur to:\n\n• Force-close blocked applications\n• Provide stronger enforcement\n• Prevent apps from bypassing blocking\n• Offer more reliable blocking\n\nThis permission is completely optional - the app works without it.</string>

    <!-- Privacy assurance -->
    <string name="privacy_assurance_title">Privacy &amp; Security</string>
    <string name="privacy_assurance_message">• All permissions are optional\n• Enhanced blocking only activates with your consent\n• No data is sent to external servers\n• All processing happens locally on your device\n• You can revoke permissions anytime</string>

