        Y --> Z{Inappropriate Content?}
        Z -->|No| AA[✅ Continue Browsing]
        Z -->|Yes| BB[🚫 Apply Blur Overlay]
        
        BB --> CC{Show Islamic Guidance?}
        CC -->|Yes| DD[📖 Display Quranic Verse]
        CC -->|No| EE[📊 Update Statistics Only]
        
        DD --> FF[🤲 User Reads Guidance]
        FF --> GG{User Action}
        GG -->|Dismiss| HH[📱 Return to App]
        GG -->|Share| II[📤 Share Verse]
        GG -->|Learn More| JJ[📚 Open Full Verse]
        
        II --> HH
        JJ --> KK[📖 Quranic Context]
        KK --> HH
        EE --> HH
        
        HH --> LL[🔄 Continue Monitoring]
        AA --> LL
        LL --> X
    end

    subgraph "🕐 Islamic Features Usage"
        MM[⏰ Prayer Time Approaching] --> NN[🔔 Prayer Notification]
        NN --> OO{User Response}
        OO -->|Pray Now| PP[🕌 Redirect to Qibla]
