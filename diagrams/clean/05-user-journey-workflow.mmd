flowchart TD
    subgraph "📲 Installation & Setup Journey"
        A[📱 User Downloads App] --> B[🚀 First Launch]
        B --> C[📋 Welcome & Permissions]
        C --> D{Grant Accessibility?}
        D -->|No| E[❌ Explain Importance]
        E --> D
        D -->|Yes| F[✅ Accessibility Enabled]
        
        F --> G[📍 Grant Overlay Permission]
        G --> H[🔔 Notification Permission]
        H --> I[📍 Location Permission - Optional]
        I --> J[⚙️ Basic Configuration]
        
        J --> K{Islamic Features?}
        K -->|Yes| L[🕌 Configure Islamic Settings]
        K -->|Skip| M[🎯 Content Detection Setup]
        
        L --> N[📖 Select Verse Categories]
        N --> O[💎 Configure Dhikr Times]
        O --> P[🕐 Set Prayer Notifications]
        P --> M
        
        M --> Q[🎨 Customize Blur Preferences]
        Q --> R[✨ Setup Complete]
    end

    subgraph "🏠 Daily Usage Flow"
        S[📱 User Opens Phone] --> T{HaramBlur Active?}
        T -->|No| U[⚠️ Service Inactive Alert]
        U --> V[🔧 Restart Service]
        V --> W[✅ Service Active]
        T -->|Yes| W
        
        W --> X[👤 User Browsing Content]
