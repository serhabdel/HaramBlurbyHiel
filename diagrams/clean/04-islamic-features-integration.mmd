        FF -->|No| HH[⏳ Wait for Next Check]
        
        GG --> II[🕌 Prayer Reminder]
        II --> JJ[Qibla Direction Helper]
        II --> KK[Prayer Time Display]
    end

    subgraph "📱 UI Integration Points"
        LL[Quranic Verse Dialog] --> MM[Contextual Display]
        NN[Dhikr Overlay] --> OO[Non-Intrusive Reminder]
        PP[Prayer Times Widget] --> QQ[Home Screen Integration]
        RR[Qibla Compass] --> SS[Prayer Direction Aid]
        
        MM --> TT{Display Method}
        TT -->|Dialog| UU[Modal Verse Display]
        TT -->|Notification| VV[Push Notification]
        TT -->|Overlay| WW[Screen Overlay]
    end

    subgraph "⚙️ Configuration & Personalization"
        XX[Islamic Settings] --> YY{Feature Enabled?}
        YY -->|Verses| ZZ[Verse Categories Selection]
        YY -->|Dhikr| AAA[Dhikr Time Preferences]
        YY -->|Prayer| BBB[Prayer Notification Settings]
        
        ZZ --> CCC[Content Category Mapping]
        AAA --> DDD[Display Duration & Style]
        BBB --> EEE[Advance Time & Sound]
    end

